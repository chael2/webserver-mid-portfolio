# MongoDB Atlas 연결 문자열 (Atlas → Connect → Drivers 에서 복사)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=portfolio

# /api/revalidate 호출용 비밀값 (아무 긴 문자열)
REVALIDATE_SECRET=change-me

# 방명록·로그인 IP 해시 솔트 (아무 긴 문자열)
IP_HASH_SALT=change-me-too

# 관리자 로그인: npm run hash-password -- "비밀번호" 로 아래 두 값을 만들어 붙여 넣기
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
